#!/bin/sh
#SBATCH --job-name=wiki-facts
#SBATCH --array=0-0
#SBATCH --partition=gpu
#SBATCH --gres=gpu:1
#SBATCH --mem=80G
#SBATCH -t 0-72:00
#SBATCH -c 1
#SBATCH --output=logs/construct-wiki-facts-%A__%a.out
#SBATCH --mail-user=anonymous@example.com
#SBATCH --mail-type=ALL
#SBATCH --account anonymous_lab


module load python/3.10.12-fasrc01
module load intelpython/3.9.16-fasrc01
module load cuda cudnn

mamba activate unlearning_3.10


## logging
CODE_DIR=/path/to/code/data_to_concept_unlearning/unlearning


## Run the experiment
cd $CODE_DIR

python construct_wiki_facts.py
