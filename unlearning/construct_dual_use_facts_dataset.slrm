#!/bin/sh
#SBATCH --job-name=construct_safe
#SBATCH --array=0-0
#SBATCH --partition=gpu
#SBATCH --gres=gpu:1
#SBATCH --mem=80G
#SBATCH -t 0-72:00
#SBATCH -c 1
#SBATCH --output=logs/construct-safe-dual-use-facts-%A__%a.out
#SBATCH --mail-user=anonymous@example.com
#SBATCH --mail-type=ALL
#SBATCH --account anonymous_lab


module load python/3.10.12-fasrc01
module load intelpython/3.9.16-fasrc01
module load cuda cudnn

mamba activate unlearning_3.10


## logging
DATA_DIR=/path/to/data/wikipedia
CODE_DIR=/path/to/code/data_to_concept_unlearning/unlearning


## Run the experiment
cd $CODE_DIR

python construct_dual_use_facts_dataset.py
